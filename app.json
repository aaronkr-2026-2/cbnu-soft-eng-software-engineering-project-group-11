{
  "expo": {
    "name": "FILMER",
    "slug": "filmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "filmer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FILMER to access your photos so you can attach scans to film rolls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
